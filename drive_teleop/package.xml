<?xml version="1.0"?>
<package format="3">
  <name>drive_teleop</name>
  <version>0.1.0</version>
  <description>
    Teleoperation package for rover control.
    Converts joystick input into tank drive wheel speed commands.
  </description>

  <maintainer email="your_email@example.com">Your Name</maintainer>
  <license>MIT</license>

  <!-- Build Tool -->
  <buildtool_depend>ament_python</buildtool_depend>

  <!-- Runtime Dependencies -->
  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>joy</depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>

